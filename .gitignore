# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# 运行输出 / 生成物
output/
src/*.pyc

# 手册 / 网页构建产物 (可重新生成, 不入库)
_pdf_build/
teaching/web/*/_build/

# 教学视频与质检抽帧 (生成物, 134MB; 重新生成见 teaching/README.md)
teaching/videos/

# IDE / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 打包产物
*.whl
*.tar.gz

# 冒烟/调试临时产物
img/_smoke.png
src/_t_*.py
src/_dbg_*.py
src/_diff_*.py
src/_single_*.py

# C++ 加速库产物: 不入库。二进制随平台而异, 且 Windows-only 的 .dll 会让
# Linux/macOS 用户以为"没有加速可用"。用 `make cpp` 或 scripts/build_cpp.py
# 现场编译, 缺失时 Python 侧自动回退到等价实现。
cpp/*.dll
cpp/*.so
cpp/*.dylib
cpp/*.o

# 论文及其实验脚本/数据: 整体不入库 (学位论文、期刊稿、综述、figs、exp、data)
thesis/

# 实验目录: 脚本入库, 数据与图是产物不入库
experiments/data/
experiments/figs/
experiments/**/__pycache__/

# JOSE 论文: 与学位论文同样不入库。paper.md/paper.bib 与 paper/ 的排版稿、
# PDF 全部只留在本地。若要投稿 JOSE 再按届时的决定放回 —— 见 paper/README.md。
paper.md
paper.bib
paper/

# 报告模板, 不入库
_tpl/

# GPU 版：大规模数据集 / 临时样本不提交 (可重新生成)
gpu/data/*.npz
gpu/data/*_x.npy
gpu/data/pr_*.png
gpu/data/_*.py
gpu/data/*.json

# 训练模型产物 (二进制, 可重新训练)
# 例外: 两个可部署模型随仓库分发, 否则 clone 后 ML 功能不可用
models/*.joblib
*.joblib
!models/stego_classifier.joblib
!models/stego_classifier_v2_jpeg_lgb_51d.joblib

# CNN 训练检查点: 体积大 (Xu-Net 33MB) 且可由 gpu/train_cnn.py 重训, 不入库。
models/*.pt

# 本地数据集与训练日志 (体积大或可再生, 归档见 D:\Users\32403\.zcode\archive)
data/dataset_*.csv
data/campus_jpg/
data/_*.log

# webapp 测试依赖 (CI 里 npm ci 重新安装; package-lock.json 需要提交)
webapp/tests/node_modules/
webapp/tests/.npm-cache/

yccstego/